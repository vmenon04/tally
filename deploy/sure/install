#!/bin/sh
# Installs or upgrades Sure in /srv/sure from the compose.yml next to this script, starts
# it, and puts it on the tailnet if Tailscale is installed. Needs tally set up first, since
# Sure's chat goes to tally chat. Run as root on the server; see docs/server.md.
set -eu

if [ "$(id -u)" != 0 ]; then
    echo "install: run with sudo" >&2
    exit 1
fi

here=$(dirname "$0")
umask 077
install -d -m 700 /srv/sure
install -m 600 "$here/compose.yml" /srv/sure/compose.yml
# The logo, read by the web container (which runs as another user), so readable by all.
install -d -m 755 /srv/sure/brand
install -m 644 "$here"/brand/* /srv/sure/brand/
chmod 755 /srv/sure/brand/apply

# Made once and never replaced: SECRET_KEY_BASE encrypts what Sure stores, so a new one
# would make the database unreadable.
if [ ! -e /srv/sure/.env ]; then
    printf 'SECRET_KEY_BASE=%s\nPOSTGRES_PASSWORD=%s\n' \
        "$(openssl rand -hex 64)" "$(openssl rand -hex 24)" >/srv/sure/.env
fi

# Tokens made once, of which tally keeps a copy in its secrets: the one Sure's chat gives
# `tally chat`, and the one `tally lookups` gives Sure's /mcp for the chat's lookups.
for pair in CHAT_TOKEN:chat-token MCP_TOKEN:sure-mcp-token; do
    name=${pair%%:*}
    if ! grep -q "^$name=" /srv/sure/.env; then
        printf '%s=%s\n' "$name" "$(openssl rand -hex 32)" >>/srv/sure/.env
    fi
    sed -n "s/^$name=//p" /srv/sure/.env >"/srv/tally/secrets/${pair#*:}"
    chown tally:tally "/srv/tally/secrets/${pair#*:}"
done
# Whose data the lookups read: the account you sign in to Sure with.
if ! grep -q '^MCP_USER_EMAIL=' /srv/sure/.env; then
    printf 'The email you sign in to Sure with: '
    read -r email
    printf 'MCP_USER_EMAIL=%s\n' "$email" >>/srv/sure/.env
fi
# Where tally's chat container makes its socket: anyone may open it, so it needs the token.
install -d -o tally -g tally -m 755 /srv/tally-chat

docker compose --project-directory /srv/sure up -d --wait
if command -v tailscale >/dev/null; then
    tailscale serve --bg http://127.0.0.1:3200
else
    echo "Sure listens on 127.0.0.1:3200; without Tailscale, reach it some other way (an SSH tunnel)."
fi
# tally chat reads its token when it starts.
if [ -n "$(docker ps --quiet --filter name=^tally-chat-1$)" ]; then
    docker restart tally-chat-1 >/dev/null
fi
