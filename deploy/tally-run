#!/bin/sh
# Runs a tally command on the server, in a one-off container of the deployed image: the same
# version, user, folders and lockdown as the scheduled runs. Installed root-owned as
# /usr/local/bin/tally-run; deploy/sudoers lets your account run it, and nothing else, as
# root without a password. Starting a container needs Docker, which only root can use, but
# the arguments only ever reach tally, which runs as the tally user.
#
#     sudo tally-run sync --dry-run
#
# COMPOSE_DIR is the folder of the compose file that runs tally, with a `cli` service for
# these commands (see docs/server.md).
set -eu

COMPOSE_DIR=/srv/deploy/services/tally

if [ "$(id -u)" != 0 ]; then
    echo "tally-run: run it with sudo: sudo tally-run ..." >&2
    exit 1
fi
if [ ! -f "$COMPOSE_DIR/compose.yml" ]; then
    echo "tally-run: no compose file in $COMPOSE_DIR; deploy tally first" >&2
    exit 1
fi

cd "$COMPOSE_DIR"
# A terminal only when there is one, for prompts such as gmail-login's.
tty=-T
if [ -t 0 ] && [ -t 1 ]; then
    tty=
fi
# Everything after the service's name is tally's arguments, never Docker's.
exec docker compose run --rm --quiet-pull $tty cli "$@"
