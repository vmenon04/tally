# Answers Sure's chat from the ledger (tally chat), all the time, on a Unix socket in
# /srv/tally-chat. Sure reaches it through the relay in its compose file; requests need the
# token in secrets/chat-token. See docs/server.md.

[Unit]
Description=tally: answer Sure's chat
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tally
Group=tally
WorkingDirectory=/srv/tally/data
Environment=TALLY_DATA_DIR=/srv/tally/data
Environment=TALLY_SECRETS_DIR=/srv/tally/secrets
# "Today" follows the owner's time zone, not the server's.
Environment=TZ=America/New_York
ExecStart=/srv/tally/venv/bin/tally chat --socket /srv/tally-chat/chat.sock
Restart=on-failure
RestartSec=10s
# Nothing is logged but errors; keep any output out of the journal all the same.
StandardOutput=null
StandardError=journal

# Can write only to the data folder, like the scheduled runs, and its socket's folder.
UMask=0077
ProtectSystem=strict
ReadWritePaths=/srv/tally/data /srv/tally-chat
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# The network is for Claude; the chat itself is only the Unix socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: with it, uv's Python can't start threads, which the chat needs.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
