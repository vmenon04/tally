# Brings the ledger up to date every two hours (tally sync): new transactions and pending
# purchases from SimpleFIN, Claude for new merchants, Fidelity holdings from SimpleFIN,
# Sure made to match, and notifications.
# Started by tally-sync.timer. See docs/server.md and docs/ledger.md.

[Unit]
Description=tally: bring the ledger up to date
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=tally
Group=tally
WorkingDirectory=/srv/tally/data
Environment=TALLY_DATA_DIR=/srv/tally/data
Environment=TALLY_SECRETS_DIR=/srv/tally/secrets
# The budget's months and "today" follow your time zone, not the server's.
Environment=TZ=America/New_York
ExecStart=/srv/tally/venv/bin/tally sync
TimeoutStartSec=10min
# The output names merchants and amounts; keep it out of the system journal.
# Errors still go there (by default they'd follow the output and be discarded too).
StandardOutput=null
StandardError=journal

# Can write only to its own data folder; everything else is read-only or hidden.
UMask=0077
ProtectSystem=strict
ReadWritePaths=/srv/tally/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: with it, uv's Python can't start threads, which some
# libraries tally uses need.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
