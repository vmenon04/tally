#!/bin/sh
# Installs a new version of the code from a `git archive` tarball, once its tests pass on this
# machine. Installed root-owned as /usr/local/bin/tally-deploy and run by bin/tally-remote as
#     sudo -u tally tally-deploy ARCHIVE COMMIT
# which asks for the owner's password (deploy/sudoers doesn't cover it): new code can read the
# secrets, so installing it takes more than running tally does.
#
# The code is unpacked and tested in app.new/, then swapped in for app/ (the previous version
# is kept as app.old/). The scheduled runs use /srv/tally/venv, a separate environment with
# tally installed as a copy (--no-editable), so it never points into a folder being replaced.
set -eu

if [ "$(id -un)" != tally ]; then
    echo "tally-deploy: run as the tally user: sudo -u tally tally-deploy ..." >&2
    exit 1
fi
if [ $# -ne 2 ]; then
    echo "usage: tally-deploy ARCHIVE COMMIT" >&2
    exit 2
fi
archive=$1
commit=$2
case $commit in
    '' | *[!0-9a-f]*)
        echo "tally-deploy: $commit isn't a commit ID" >&2
        exit 2
        ;;
esac

export HOME=/srv/tally
umask 077
cd /srv/tally
UV=/srv/tally/bin/uv

rm -rf app.new
mkdir app.new
tar xzf "$archive" -C app.new
echo "$commit" >app.new/REVISION

echo "tally-deploy: testing $commit"
(cd app.new && "$UV" sync --frozen --quiet && "$UV" run --frozen pytest -q)
rm -rf app.new/.venv

rm -rf app.old
if [ -d app ]; then
    mv app app.old
fi
mv app.new app
(cd app && UV_PROJECT_ENVIRONMENT=/srv/tally/venv "$UV" sync --frozen --no-dev --no-editable --quiet)
echo "tally-deploy: now running $commit"
