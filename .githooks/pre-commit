#!/usr/bin/env bash
# Blocks commits that include secrets or personal data, then runs the checks.
# Enabled per clone with: git config core.hooksPath .githooks
set -euo pipefail

fail() { echo "pre-commit: $*" >&2; exit 1; }

# 1. No files from secrets/ or data/, and no file types that hold tokens or transactions.
blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(secrets|data)/|\.(db|sqlite[0-9]*)$|(^|/)\.env$|service[-_]?account.*\.json$|token.*\.json$' \
  || true)
# Bank exports and emails are allowed only as made-up test fixtures.
exports=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.(csv|eml)$' | grep -vE '^tests/fixtures/' || true)
if [[ -n "$blocked$exports" ]]; then
  fail "refusing to commit secrets or personal data:
$blocked$exports"
fi

# 2. No credential-shaped strings in the staged changes (this hook itself is exempt).
if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' \
  | grep -E '^\+' \
  | grep -qE 'sk-ant-[A-Za-z0-9_-]{10,}|"private_key"|-----BEGIN [A-Z ]*PRIVATE KEY-----|"refresh_token"'; then
  fail "staged changes contain something that looks like a credential"
fi

# 3. Same checks as CI.
"$(git rev-parse --show-toplevel)/bin/check"
