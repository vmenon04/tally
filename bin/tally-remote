#!/usr/bin/env bash
# Runs tally on the server from this machine, in the image the server has deployed. The
# server holds the only copy of the data.
#
#     tally-remote fava [PORT]        edit the ledger in Fava at http://localhost:PORT (default 5000)
#     tally-remote COMMAND ...        any other tally command, e.g. sync --dry-run, simplefin
#
# TALLY_HOST names the server, an entry in ~/.ssh/config: set it in your environment or in
# the repo's .env (see .env.example). See docs/server.md.
set -euo pipefail

if [[ -z ${TALLY_HOST:-} && -f "$(dirname "$0")/../.env" ]]; then
    TALLY_HOST=$(sed -n 's/^TALLY_HOST=//p' "$(dirname "$0")/../.env")
fi
HOST=${TALLY_HOST:?set TALLY_HOST to your server, here or in .env (see .env.example)}
DROP=/srv/tally-inbox

# Runs tally-run on the server with these arguments, quoted for the remote shell.
remote_tally() {
    local tty=()
    if [[ -t 0 && -t 1 ]]; then
        tty=(-t) # for prompts such as gmail-login's
    fi
    exec ssh ${tty[@]+"${tty[@]}"} -q "$HOST" "sudo -n /usr/local/bin/tally-run$(printf ' %q' "$@")"
}

case ${1:-} in
    "" | -h | --help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    fava)
        # Starts Fava on the server for as long as this stays open, on a socket in a folder
        # only your account and tally can open, and forwards a port on this machine to it.
        port=${2:-5000}
        echo "Fava: http://localhost:$port  (Ctrl-C to stop)"
        exec ssh -t -q -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:$DROP/fava.sock" "$HOST" \
            "sudo -n /usr/local/bin/tally-run fava --socket $DROP/fava.sock"
        ;;
    *)
        remote_tally "$@"
        ;;
esac
