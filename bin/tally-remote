#!/usr/bin/env bash
# Runs tally on the server from this machine. The server holds the only copy of the data.
#
#     tally-remote deploy             push this repo's last commit, then install it on the server
#     tally-remote fava [PORT]        edit the ledger in Fava at http://localhost:PORT (default 5000)
#     tally-remote COMMAND ...        any other tally command, e.g. sync --dry-run, simplefin
#
# TALLY_HOST names the server, an entry in ~/.ssh/config: set it in your environment or in
# the repo's .env (see .env.example). See docs/server.md.
set -euo pipefail

if [[ -z ${TALLY_HOST:-} && -f "$(dirname "$0")/../.env" ]]; then
    TALLY_HOST=$(sed -n 's/^TALLY_HOST=//p' "$(dirname "$0")/../.env")
fi
HOST=${TALLY_HOST:?set TALLY_HOST to your server, here or in .env (see .env.example)}
DROP=/srv/tally-inbox

# Runs tally-run on the server with these arguments, quoted for the remote shell.
remote_tally() {
    local tty=()
    if [[ -t 0 && -t 1 ]]; then
        tty=(-t) # for prompts such as gmail-login's
    fi
    exec ssh ${tty[@]+"${tty[@]}"} -q "$HOST" "sudo -n -u tally /usr/local/bin/tally-run$(printf ' %q' "$@")"
}

deploy() {
    local repo commit archive
    repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
    if [[ -n $(git -C "$repo" status --porcelain) ]]; then
        echo "tally-remote: commit or stash your changes first; only committed code is deployed" >&2
        exit 1
    fi
    git -C "$repo" push origin HEAD
    commit=$(git -C "$repo" rev-parse HEAD)
    archive=$(ssh -q "$HOST" 'f=$(mktemp /tmp/tally-app.XXXXXX) && chmod 644 "$f" && echo "$f"')
    git -C "$repo" archive --format=tar.gz HEAD | ssh -q "$HOST" "cat >$archive"
    echo "deploying $(git -C "$repo" log --oneline -1)"
    status=0
    # tally chat runs all the time, so it restarts onto the new code (try-restart leaves it
    # alone if it isn't running); sudo remembers the password from the deploy.
    ssh -t -q "$HOST" "sudo -u tally /usr/local/bin/tally-deploy $archive $commit &&
        { sudo systemctl try-restart tally-chat ||
            echo 'tally-remote: restart tally-chat by hand' >&2; }" || status=$?
    ssh -q "$HOST" "rm -f $archive"
    exit $status
}

case ${1:-} in
    "" | -h | --help)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    deploy)
        deploy
        ;;
    fava)
        # Starts Fava on the server for as long as this stays open, on a socket in a folder
        # only your account and tally can open, and forwards a port on this machine to it.
        port=${2:-5000}
        echo "Fava: http://localhost:$port  (Ctrl-C to stop)"
        exec ssh -t -q -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:$DROP/fava.sock" "$HOST" \
            "sudo -n -u tally /usr/local/bin/tally-run fava --socket $DROP/fava.sock"
        ;;
    *)
        remote_tally "$@"
        ;;
esac
